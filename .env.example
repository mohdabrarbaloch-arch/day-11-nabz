# ── Core ─────────────────────────────────────────────────────────────
# development | production. In production, SECRET_KEY must be >= 32 chars.
ENVIRONMENT=development

# Signing key for JWTs. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Token lifetime in minutes (default 12 hours)
ACCESS_TOKEN_MINUTES=720

# ── Database ─────────────────────────────────────────────────────────
# SQLite (zero config, default):
DATABASE_URL=sqlite:///./nabz.db
# PostgreSQL (what docker-compose uses):
# DATABASE_URL=postgresql+psycopg://nabz:nabz@db:5432/nabz

# ── Security ─────────────────────────────────────────────────────────
# Comma-separated allowed origins. Never use * with credentials enabled.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=120
# Login attempts per minute per client IP
LOGIN_RATE_LIMIT_PER_MINUTE=10

# bcrypt cost factor. 12 in production; lower only for tests.
BCRYPT_ROUNDS=12

# ── Demo data ────────────────────────────────────────────────────────
# Seed the demo clinician + 10 synthetic patients on first boot.
# Set to false for a clean deployment.
SEED_ON_STARTUP=true
